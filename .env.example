# Copy to .env and adjust. Every variable has a development default in application.yml that
# matches docker-compose.yml, so for local work the file can stay empty. Production must set
# all credentials explicitly.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/slicercore
DB_USERNAME=sliceruser
DB_PASSWORD=slicerpassword

# RabbitMQ (only used when APP_MESSAGING_ENABLED=true, roadmap phase 6)
APP_MESSAGING_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=slicer_mq
RABBITMQ_PASSWORD=slicer_mq_pass

# S3-compatible object storage (roadmap phase 2)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password
S3_BUCKET_NAME=slicer-files
S3_REGION=us-east-1

# Slicer
SLICER_BINARY_PATH=bambu-studio-cli

# Quote API
SUPPORT_EMAIL=
ADMIN_TOKEN=
