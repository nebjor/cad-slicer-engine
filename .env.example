# Copy to .env and adjust. Every variable has a development default in application.yml that
# matches docker-compose.yml, so for local work the file can stay empty. Production must set
# all credentials explicitly.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/slicercore
DB_USERNAME=sliceruser
DB_PASSWORD=slicerpassword

# Slicer
SLICER_BINARY_PATH=bambu-studio-cli

# Quote API
SUPPORT_EMAIL=

# Owner login for the admin area (/admin and /api/admin/**). Blank password = admin disabled.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Orders and payment. PUBLIC_BASE_URL is the shop origin customers see; payment pages redirect to it.
ORDER_FILES_DIR=./data/order-files
PAYMENT_PROVIDER=mock
PUBLIC_BASE_URL=http://localhost:4200

# Order mails (confirmation, shipping notice, owner copy). MAIL_ENABLED=false logs them instead.
# Infomaniak: host mail.infomaniak.com, port 587 (STARTTLS), username = the full address.
MAIL_ENABLED=false
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=info@3dburg.ch
OWNER_EMAIL=
